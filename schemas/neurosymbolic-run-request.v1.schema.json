{
  "$defs": {
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityTerm": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "entity",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EntityTerm",
      "type": "object"
    },
    "FormalAstInput": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "#/$defs/GroundLiteral"
        },
        "theory": {
          "$ref": "#/$defs/Theory"
        }
      },
      "required": [
        "theory",
        "query"
      ],
      "title": "FormalAstInput",
      "type": "object"
    },
    "GroundLiteral": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "$ref": "#/$defs/EntityTerm"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Arguments",
          "type": "array"
        },
        "negated": {
          "title": "Negated",
          "type": "boolean"
        },
        "predicate": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Predicate",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "predicate",
        "arguments",
        "negated",
        "source_id"
      ],
      "title": "GroundLiteral",
      "type": "object"
    },
    "InputMode": {
      "enum": [
        "NATURAL_LANGUAGE",
        "FORMAL_AST"
      ],
      "title": "InputMode",
      "type": "string"
    },
    "NaturalLanguageInput": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "statements": {
          "items": {
            "$ref": "#/$defs/NaturalLanguageStatement"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Statements",
          "type": "array"
        }
      },
      "required": [
        "statements",
        "query"
      ],
      "title": "NaturalLanguageInput",
      "type": "object"
    },
    "NaturalLanguageStatement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/StatementKind"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "NaturalLanguageStatement",
      "type": "object"
    },
    "ParserMetadata": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "model_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "parser_name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Parser Name",
          "type": "string"
        },
        "parser_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$",
          "title": "Parser Version",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "parser_name",
        "parser_version"
      ],
      "title": "ParserMetadata",
      "type": "object"
    },
    "PolicyMode": {
      "enum": [
        "P0_RAW",
        "P1_CORRECTED",
        "P2_SELECTIVE"
      ],
      "title": "PolicyMode",
      "type": "string"
    },
    "PredicateDefinition": {
      "additionalProperties": false,
      "properties": {
        "argument_types": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Argument Types"
        },
        "arity": {
          "enum": [
            1,
            2
          ],
          "title": "Arity",
          "type": "integer"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arity"
      ],
      "title": "PredicateDefinition",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "items": {
            "$ref": "#/$defs/RuleLiteral"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Body",
          "type": "array"
        },
        "head": {
          "$ref": "#/$defs/RuleLiteral"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/VariableDefinition"
          },
          "maxItems": 64,
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "id",
        "variables",
        "body",
        "head",
        "source_id"
      ],
      "title": "Rule",
      "type": "object"
    },
    "RuleLiteral": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "discriminator": {
              "mapping": {
                "entity": "#/$defs/EntityTerm",
                "variable": "#/$defs/VariableTerm"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EntityTerm"
              },
              {
                "$ref": "#/$defs/VariableTerm"
              }
            ]
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Arguments",
          "type": "array"
        },
        "negated": {
          "title": "Negated",
          "type": "boolean"
        },
        "predicate": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Predicate",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "predicate",
        "arguments",
        "negated",
        "source_id"
      ],
      "title": "RuleLiteral",
      "type": "object"
    },
    "SourceStatement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "SourceStatement",
      "type": "object"
    },
    "StatementKind": {
      "enum": [
        "fact",
        "rule"
      ],
      "title": "StatementKind",
      "type": "string"
    },
    "Theory": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Entities",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/GroundLiteral"
          },
          "maxItems": 100000,
          "title": "Facts",
          "type": "array"
        },
        "parser_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParserMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "predicates": {
          "items": {
            "$ref": "#/$defs/PredicateDefinition"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Predicates",
          "type": "array"
        },
        "query": {
          "$ref": "#/$defs/GroundLiteral"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "maxItems": 10000,
          "title": "Rules",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_statements": {
          "items": {
            "$ref": "#/$defs/SourceStatement"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Source Statements",
          "type": "array"
        },
        "theory_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Theory Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "theory_id",
        "source_statements",
        "entities",
        "predicates",
        "facts",
        "rules",
        "query"
      ],
      "title": "Theory",
      "type": "object"
    },
    "VariableDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "required": [
        "name"
      ],
      "title": "VariableDefinition",
      "type": "object"
    },
    "VariableTerm": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "variable",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "VariableTerm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "formal_ast": {
      "anyOf": [
        {
          "$ref": "#/$defs/FormalAstInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_mode": {
      "$ref": "#/$defs/InputMode"
    },
    "natural_language": {
      "anyOf": [
        {
          "$ref": "#/$defs/NaturalLanguageInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_mode": {
      "$ref": "#/$defs/PolicyMode",
      "default": "P2_SELECTIVE"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "input_mode"
  ],
  "title": "PipelineRequest",
  "type": "object"
}
