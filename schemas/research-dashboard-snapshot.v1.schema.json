{
  "$defs": {
    "CatalogueOverview": {
      "additionalProperties": false,
      "properties": {
        "api_cost_usd_during_phase9": {
          "title": "Api Cost Usd During Phase9",
          "type": "number"
        },
        "catalogue_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Catalogue Hash",
          "type": "string"
        },
        "catalogue_id": {
          "title": "Catalogue Id",
          "type": "string"
        },
        "catalogue_version": {
          "title": "Catalogue Version",
          "type": "string"
        },
        "comparison_count": {
          "minimum": 0,
          "title": "Comparison Count",
          "type": "integer"
        },
        "evidence_validation_status": {
          "const": "VERIFIED",
          "default": "VERIFIED",
          "title": "Evidence Validation Status",
          "type": "string"
        },
        "experiment_count": {
          "minimum": 0,
          "title": "Experiment Count",
          "type": "integer"
        },
        "experiments": {
          "items": {
            "$ref": "#/$defs/ExperimentSummary"
          },
          "title": "Experiments",
          "type": "array"
        },
        "global_limitations": {
          "items": {
            "type": "string"
          },
          "title": "Global Limitations",
          "type": "array"
        },
        "hosted_provider_calls_during_phase9": {
          "title": "Hosted Provider Calls During Phase9",
          "type": "integer"
        },
        "local_provider_calls_during_phase9": {
          "title": "Local Provider Calls During Phase9",
          "type": "integer"
        },
        "provider_calls_during_phase8": {
          "title": "Provider Calls During Phase8",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "zero_cost": {
          "title": "Zero Cost",
          "type": "boolean"
        }
      },
      "required": [
        "catalogue_id",
        "catalogue_version",
        "catalogue_hash",
        "experiment_count",
        "comparison_count",
        "experiments",
        "global_limitations",
        "zero_cost",
        "provider_calls_during_phase8",
        "local_provider_calls_during_phase9",
        "hosted_provider_calls_during_phase9",
        "api_cost_usd_during_phase9"
      ],
      "title": "CatalogueOverview",
      "type": "object"
    },
    "ComparisonCompatibility": {
      "additionalProperties": false,
      "properties": {
        "comparison_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Comparison Id",
          "type": "string"
        },
        "comparison_type": {
          "$ref": "#/$defs/ComparisonType"
        },
        "evidence_sources": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Sources",
          "type": "array"
        },
        "experiment_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Experiment Ids",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Limitations",
          "type": "array"
        },
        "outcome_counts": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Outcome Counts",
          "type": "object"
        },
        "paired": {
          "title": "Paired",
          "type": "boolean"
        },
        "same_selection": {
          "title": "Same Selection",
          "type": "boolean"
        },
        "supported_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Supported Metrics",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "warning": {
          "title": "Warning",
          "type": "string"
        }
      },
      "required": [
        "comparison_id",
        "title",
        "comparison_type",
        "experiment_ids",
        "paired",
        "same_selection",
        "supported_metrics",
        "warning",
        "evidence_sources"
      ],
      "title": "ComparisonCompatibility",
      "type": "object"
    },
    "ComparisonType": {
      "enum": [
        "PAIRED",
        "SAME_SELECTION_DIFFERENT_REPRESENTATION",
        "DESCRIPTIVE_ONLY",
        "INCOMPARABLE"
      ],
      "title": "ComparisonType",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "DIRECTLY_OBSERVED",
        "DERIVED",
        "DOCUMENTED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "EvidenceVerification": {
      "enum": [
        "HASH_VERIFIED",
        "CROSS_CHECKED",
        "SOURCE_HASH_RECORDED",
        "UNAVAILABLE"
      ],
      "title": "EvidenceVerification",
      "type": "string"
    },
