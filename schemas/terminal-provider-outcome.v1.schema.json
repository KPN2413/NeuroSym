{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilogic-ns.local/schemas/terminal-provider-outcome.v1.schema.json",
  "title": "VeriLogic-NS Terminal Provider Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome_type",
    "outcome_id",
    "stage",
    "error_code",
    "pipeline_status",
    "reason",
    "request_hash",
    "prompt_hash",
    "output_schema_hash",
    "semantic_config_hash",
    "provider",
    "model",
    "model_digest",
    "runtime",
    "permitted_attempt_count",
    "observed_attempt_count",
    "output_token_limit",
    "attempts",
    "input_tokens",
    "output_tokens",
    "total_duration_ms",
    "attempt_evidence_hashes",
    "first_observed_at",
    "last_observed_at",
    "valid_structured_result_produced",
    "final",
    "terminal_outcome_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "outcome_type": {"const": "TERMINAL_ERROR"},
    "outcome_id": {"$ref": "#/$defs/sha256"},
    "stage": {
      "enum": [
        "semantic_parser_theory",
        "semantic_parser_query",
        "theory_critic",
        "query_critic",
        "theory_correction",
        "query_correction"
      ]
    },
    "error_code": {
      "enum": [
        "OUTPUT_LIMIT_EXHAUSTED",
        "INVALID_STRUCTURED_OUTPUT",
        "TIMEOUT_EXHAUSTED",
        "TRANSIENT_RETRY_EXHAUSTED",
        "PROVIDER_FAILURE"
      ]
    },
    "pipeline_status": {
      "enum": ["STRUCTURED_OUTPUT_ERROR", "TIMEOUT", "PROVIDER_ERROR"]
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "request_hash": {"$ref": "#/$defs/sha256"},
    "prompt_hash": {"$ref": "#/$defs/sha256"},
    "output_schema_hash": {"$ref": "#/$defs/sha256"},
    "semantic_config_hash": {"$ref": "#/$defs/sha256"},
    "provider": {"const": "ollama"},
    "model": {"type": "string", "minLength": 1},
    "model_digest": {"$ref": "#/$defs/sha256"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "permitted_attempt_count": {"type": "integer", "minimum": 1, "maximum": 3},
    "observed_attempt_count": {"type": "integer", "minimum": 1, "maximum": 3},
    "output_token_limit": {"type": "integer", "minimum": 1, "maximum": 8192},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/attempt"}
    },
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "total_duration_ms": {"type": "number", "minimum": 0},
    "attempt_evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "first_observed_at": {"type": "string", "format": "date-time"},
    "last_observed_at": {"type": "string", "format": "date-time"},
    "valid_structured_result_produced": {"const": false},
    "final": {"const": true},
    "terminal_outcome_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "provider_version",
        "model",
        "model_digest",
        "temperature",
        "seed",
        "num_ctx",
        "num_predict",
        "think",
        "concurrency"
      ],
      "properties": {
        "endpoint": {
          "enum": ["http://127.0.0.1:11434", "http://localhost:11434"]
        },
        "provider_version": {"type": "string"},
        "model": {"type": "string"},
        "model_digest": {"$ref": "#/$defs/sha256"},
        "temperature": {"const": 0},
        "seed": {"type": "integer"},
        "num_ctx": {"type": "integer", "minimum": 4096, "maximum": 32768},
        "num_predict": {"type": "integer", "minimum": 1, "maximum": 8192},
        "think": {"const": false},
        "concurrency": {"const": 1}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_number",
        "request_hash",
        "evidence_sha256",
        "input_tokens",
        "output_tokens",
        "total_duration_ms",
        "observed_at",
        "valid_structured_result"
      ],
      "properties": {
        "attempt_number": {"type": "integer", "minimum": 1, "maximum": 3},
        "request_hash": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "finish_reason": {"type": ["string", "null"], "maxLength": 128},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_duration_ms": {"type": "number", "minimum": 0},
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_structured_result": {"const": false}
      }
    }
  }
}
